# Copy to .env for local development. On Azure App Service, set these under
# Configuration > Application settings instead -- .env is not deployed
# (see .gitignore) and App Service injects Application settings as real
# environment variables, which app/config.py's load_dotenv() call doesn't
# interfere with (it's a no-op if .env doesn't exist).

# --- LLM providers (app/llm/*) ---
# extract_product() tries these in order: Gemini -> Groq -> GitHub Models.
# None are required for the app to start -- each client only raises at
# call time if its key is missing, so /extract/file and /extract/url on
# PDF/DOCX/URL sources will fail with a clear error until at least one is
# set. The CSV/XLSX path (/extract/file with a catalog) needs none of these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# --- Web ingestion fallback (app/ingestion/web_fetcher.py, catalog_crawler.py) ---
# Used only when a plain static fetch fails (JS-heavy or bot-walled pages).
# /extract/url still works without this for sites that don't need it.
FIRECRAWL_API_KEY=

# --- API layer (app/main.py) ---
# Comma-separated list of allowed CORS origins, e.g.
# https://your-frontend.azurestaticapps.net,http://localhost:5173
# Defaults to "*" (any origin) if unset -- fine for a demo, worth narrowing
# once the frontend's real deployed URL is known.
ALLOWED_ORIGINS=*
