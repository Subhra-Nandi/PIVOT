# Copy to .env and fill in. .env is gitignored; this file is committed.

# --- LLM provider selection ---
# Single interface, provider swapped via config so a rate limit mid-demo
# doesn't require code changes. Order of fallback: gemini -> groq -> github.
LLM_PROVIDER=gemini

# --- Google Gemini (AI Studio) — primary, free tier ---
# Use Flash / Flash-Lite, NOT Pro (Pro free quota is far more restricted).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq — fallback (fast open-weight inference) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub Models — tertiary fallback (small context window) ---
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# --- Firecrawl — Phase 2 web ingestion fallback ---
# Only needed when a static fetch fails or comes back thin (JS-heavy/bot-walled
# sites) and for catalog-listing crawls. Single-page static scraping and
# CSV/XLSX/PDF/DOCX ingestion work without it. Free key: firecrawl.dev
FIRECRAWL_API_KEY=
